# Obsidian writes the plugin's local settings here. Never commit it.
data.json

# Release archives and local build output
*.zip
build/

# Node (not used, but keeps stray installs out)
node_modules/
package-lock.json

# OS noise
.DS_Store
Thumbs.db
desktop.ini

# Editor noise
.vscode/
.idea/
*.swp
*~

# Raw screen recordings (the exported GIF is committed, the source is not)
*.mp4
*.mkv

# ...except the hero video, which the README links to
!docs/hero.mp4

# Design source. Large, binary, and not needed to build or install the plugin.
design/*

# ...except the render sources and the page-sized vector exports, which are small
# and worth keeping. Note the pattern excludes contents rather than the folder
# itself, because git will not look inside a folder it has already excluded.
!design/sources/
!design/pdf/
design/pdf/*
!design/pdf/*.pdf

# Intermediate video encodes
*.webm
